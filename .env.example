# cp .env.example .env (docker compose won't start without .env).
# Quote a value only if it contains spaces or '#'.
# Variables left over from the previous validator (Solana, BTC, ETH, DB, wandb, ...) are ignored.

NETUID=7
WALLET_NAME=default                 # your btcli names (`btcli w list`)
HOTKEY_NAME=default
WALLET_PATH=~/.bittensor/wallets    # absolute path for docker (compose does not expand ~)
SUBTENSOR_NETWORK=finney            # finney | ws://host:9944 | a keyed provider URL (shown redacted in logs)
# OPTIONAL comma-separated endpoints tried in turn when the current one fails
# SUBTENSOR_FALLBACK_ENDPOINTS=wss://entrypoint-finney.opentensor.ai:443
LOG_LEVEL=info                      # info | debug | trace
# Rotating log file data/allways/bittensor.log (survives container rebuilds): size per file, files kept.
LOG_FILE_MAX_MB=10
LOG_FILE_BACKUPS=4
# OPTIONAL full (default) sets weights; watch or vote runs the loop and only logs what it would set
# VALIDATOR_MODE=full
